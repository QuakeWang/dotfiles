#!/usr/bin/env bash

# global settings
yabai -m config mouse_follows_focus off
yabai -m config focus_follows_mouse off
yabai -m config window_origin_display default
yabai -m config window_placement second_child
yabai -m config window_shadow float
yabai -m config window_opacity on
yabai -m config window_opacity_duration 0.15
yabai -m config active_window_opacity 0.95
yabai -m config normal_window_opacity 0.85
yabai -m config insert_feedback_color 0xff9dd274
yabai -m config split_ratio 0.50
yabai -m config auto_balance off
yabai -m config mouse_modifier alt
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize
yabai -m config mouse_drop_action swap
yabai -m config external_bar all:53:0

# signal with sketchybar
yabai -m signal --add event=window_focused action="sketchybar --trigger window_focus"
yabai -m signal --add event=window_created action="sketchybar --trigger windows_on_spaces"
yabai -m signal --add event=window_destroyed action="sketchybar --trigger windows_on_spaces"
yabai -m signal --add event=window_minimized action="sketchybar --trigger windows_on_spaces"
yabai -m signal --add event=window_deminimized action="sketchybar --trigger windows_on_spaces"
yabai -m signal --add event=application_hidden action="sketchybar --trigger windows_on_spaces"
yabai -m signal --add event=application_visible action="sketchybar --trigger windows_on_spaces"
yabai -m signal --add event=application_front_switched action="sketchybar --trigger front_app_update --trigger window_focus"
yabai -m signal --add event=space_changed action="sketchybar --trigger windows_on_spaces --trigger front_app_update"
yabai -m signal --add event=space_created action="sketchybar --trigger windows_on_spaces --trigger space_change"
yabai -m signal --add event=space_destroyed action="sketchybar --trigger windows_on_spaces --trigger space_change"

# general space settings
yabai -m config layout bsp
yabai -m config top_padding 1
yabai -m config bottom_padding 3
yabai -m config left_padding 5
yabai -m config right_padding 5
yabai -m config window_gap 4
# yabai -m config window_animation_duration    0.00

# helper overlays
yabai -m rule --add app="^iStat.*$" sticky=on manage=off
yabai -m rule --add app="^iShotHelper$" manage=off

# common transient windows
yabai -m rule --add subrole="^AXDialog$" manage=off
yabai -m rule --add subrole="^AXSystemDialog$" manage=off
yabai -m rule --add subrole="^AXFloatingWindow$" manage=off

# Proxy dashboards should float instead of consuming a BSP tile.
yabai -m rule --add app="^Clash Verge$" manage=off grid=6:6:1:1:4:4

# Keep the Harness workspace centered and outside the tiling layout.
yabai -m rule --add label=deepseek-harness app="^DeepSeek Harness$" subrole="^AXStandardWindow$" manage=off grid=10:10:1:1:8:8

# disable specific apps (grouped by category)
unmanaged_apps=(
  # System
  "^System (Preferences|Settings)$"
  "^(Calculator|Preview|Finder|Raycast)$"
  # Messaging
  "^(WeChat|QQ)$"
  "^(Feishu|Feishu Meetings|Lark)$"
  "^(WeCom|企业微信)$"
  "^(DingTalk|TencentMeeting|zoom.us)$"
  # Utilities
  "^(NeatDownloadManager|MonitorControl|DesktopLauncher|Loader|KeyboardHolder)$"
  "^(BaiduNetdisk|OpenVPN Connect|OrbStack|Antigravity)$"
  # Media & misc
  "^(QQ音乐|Music|微信读书|闲鱼|Duolingo|mpv)$"
  # Cloud
  "^(Alibaba Cloud Workspace|Cloud Computer)$"
)

for pattern in "${unmanaged_apps[@]}"; do
  yabai -m rule --add app="$pattern" manage=off
done

# Re-apply rules to windows that were already open before yabai restarted.
yabai -m rule --apply

# borders is managed by launchd through nix-darwin.

echo "yabai configuration loaded.."
